package com.linkedlist;

public class DLL {

	int count;
	Node head;
	DLL()
	{
		head=null;
		count=0;
	}
	void insertBegin(int ele)
	{
		Node nn =new Node(ele);
		if(head==null)
			head=nn;
		else
		{
			nn.next=head;
			head.prev=nn;
			head=nn;
		}
			count++;
			
	}
	void display()
	{
		if(head==null)
			{System.out.println("no ele in list");
	}
	else
	{
		Node ptr=head;
		while(ptr!=null)
		{
			System.out.println(ptr.data+"=>");
			ptr=ptr.next;

		}
		System.out.println("null");
		
	}
}}
